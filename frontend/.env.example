# MahaGrid AI Frontend Environment Variables
# Copy this file to .env and fill in values

# Backend API base URL (required)
# In development: http://localhost:3001/api/v1
# In production: https://your-backend-domain.com/api/v1
VITE_API_BASE_URL=http://localhost:3001/api/v1

# Socket.IO URL (optional, defaults to API base URL origin)
# Only set if Socket.IO server runs on a different host/port
VITE_SOCKET_URL=http://localhost:3001

# App mode label (shown in UI)
VITE_APP_MODE=DEMO
